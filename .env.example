# AlphaPulse configuration — copy to .env and fill in your own values.
#
#   cp .env.example .env
#
# Only needed for LIVE and PAPER trading (scripts/run_live.py, scripts/run_paper.py).
# Backtesting, the dashboard, and the test suite run fully offline and need none of this.
# .env is gitignored — never commit real credentials.

# ── Upstox API credentials ────────────────────────────────────────────────────
# Create a developer app at https://upstox.com/developer/apps to obtain these.
# The redirect URI must match the one registered on your Upstox app exactly.
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_REDIRECT_URI=http://localhost:8080/callback

# ── Instrument & candles ──────────────────────────────────────────────────────
# The underlying to trade. The bot buys ATM options on this index.
INSTRUMENT_KEY=NSE_INDEX|Nifty Bank
UNIT=minutes
INTERVAL=5

# Strategy used by the live/paper loop: ema | rsi | macd | bollinger
STRATEGY=ema

# ── Position sizing ───────────────────────────────────────────────────────────
# Contracts per order. Use the correct lot size for your instrument.
QUANTITY=15

# ── Risk limits (rupees) ──────────────────────────────────────────────────────
# Per-position exits.
STOP_LOSS=1000
TAKE_PROFIT=2000

# Daily caps — trading halts for the session once either is hit.
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=3000

# ── Loop timing (seconds) ─────────────────────────────────────────────────────
# How often to poll for a new signal, and how long a session runs before exiting.
TRADE_CHECK_INTERVAL=60
MAX_RUNTIME=3600
